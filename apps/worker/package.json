{
  "name": "@proofkey/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "live:mvp": "npm run build && node dist/live-mvp.js",
    "live:verify": "npm run build && node dist/verify-live.js",
    "relay": "npm run build && node dist/cli.js",
    "seed:marketplace": "npm run build && node dist/seed-marketplace.js",
    "serve": "npm run build && node dist/server.js",
    "test": "npm run build && node --test dist/evidence.test.js dist/executor.test.js dist/http.test.js dist/queue.test.js dist/relay.test.js dist/store.test.js dist/usage-receipt.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gluwa/usc-sdk": "0.18.0",
    "ethers": "6.17.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/pg": "^8.23.1",
    "typescript": "6.0.2"
  }
}
