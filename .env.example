# Public network configuration. Copy this file to .env for local development.
ETHEREUM_SEPOLIA_CHAIN_ID=11155111
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
PAYMENT_TOKEN_ADDRESS=
SEPOLIA_USAGE_PAYMENT_REGISTRY_ADDRESS=
SOURCE_CONFIRMATIONS=1

CREDITCOIN_TESTNET_CHAIN_ID=102031
CREDITCOIN_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_TESTNET_EXPLORER_URL=https://creditcoin-testnet.blockscout.com
CREDITCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
SOURCE_CHAIN_KEY=1
PROOFKEY_ASC_ADDRESS=

CREDITCOIN_MAINNET_CHAIN_ID=102030
CREDITCOIN_MAINNET_RPC_URL=https://mainnet3.creditcoin.network
CREDITCOIN_MAINNET_EXPLORER_URL=https://creditcoin.blockscout.com

# Local-only secrets. Never commit real values.
DEPLOYER_PRIVATE_KEY=
WORKER_PRIVATE_KEY=

# Durable relay database. Render injects this from its managed Postgres instance.
DATABASE_URL=postgresql://proofkey:proofkey@127.0.0.1:5432/proofkey
DATABASE_SSL=false

# Optional bounded relay settings.
SOURCE_CONFIRMATION_TIMEOUT_MS=180000
ATTESTATION_POLL_INTERVAL_MS=15000
ATTESTATION_TIMEOUT_MS=1200000
RELAY_RETRY_ATTEMPTS=3
RELAY_RETRY_BASE_DELAY_MS=2000
RELAY_QUEUE_POLL_MS=2000
RELAY_LEASE_DURATION_MS=90000
RELAY_LEASE_HEARTBEAT_MS=30000
RELAYER_MINIMUM_CC3_WEI=10000000000000000
RELAY_RATE_LIMIT_REQUESTS=10
RELAY_RATE_LIMIT_WINDOW_MS=60000
WORKER_PORT=8787
WORKER_HOST=127.0.0.1
FRONTEND_ORIGINS=http://localhost:5173,https://proofkey.vercel.app

# Reproducible live MVP settings. The defaults buy a 24-hour demo window.
DEMO_TARIFF=2500
DEMO_DURATION_SECONDS=86400
# Set only to resume a payment that succeeded before proof relay completed.
DEMO_SOURCE_TRANSACTION_HASH=

# Device simulator public configuration. Vite exposes VITE_* values to the browser;
# never put a private key or secret in these variables.
VITE_CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
VITE_CREDITCOIN_CHAIN_ID=102031
VITE_ACCESS_PASS_ADDRESS=
VITE_MACHINE_REGISTRY_ADDRESS=
VITE_DEMO_MACHINE_ID=
VITE_DEMO_BENEFICIARY_ADDRESS=

# Customer web app public configuration.
VITE_ETHEREUM_SEPOLIA_RPC_URL=
VITE_USAGE_PAYMENT_REGISTRY_ADDRESS=
# Public Reown Cloud project ID used by WalletConnect (never a private key).
VITE_WALLETCONNECT_PROJECT_ID=
VITE_PROOF_WORKER_URL=https://proofkey-relay.onrender.com
VITE_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
VITE_CREDITCOIN_EXPLORER_URL=https://creditcoin-testnet.blockscout.com
VITE_DEVICE_SIMULATOR_URL=http://localhost:4174
VITE_DEMO_MACHINE_NAME=Industrial Excavator
VITE_DEMO_MACHINE_LOCATION=Lagos Demo Yard · Bay 04
